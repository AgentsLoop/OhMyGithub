<body>
<header>
  <h1>😊 Mood Tracker</h1>
  <p>Native Android APK + Web Preview — Track daily moods, notes & stats</p>
  <p class="small" style="color:#fff;opacity:.85">APK: android/app/build/outputs/apk/debug/app-debug.apk • Package com.omg.moodtracker</p>
</header>
<div class="container">
  <div class="card">
    <h2>How are you today?</h2>
    <div class="moods" id="moods"></div>
    <textarea id="note" rows="3" placeholder="How are you feeling? Add notes…"></textarea>
    <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
      <span id="dateLabel" class="small" style="flex:1">Date: —</span>
      <button class="btn" style="width:auto;padding:8px 12px;font-size:12px" onclick="pickDate()">📅 Date</button>
      <button class="btn" style="width:auto;padding:8px 12px;font-size:12px;background:#03dac5;color:#111" onclick="pickTime()">⏰ Time</button>
    </div>
    <button class="btn" onclick="save()">Save Entry</button>
  </div>

  <div class="card">
    <h2>📅 Calendar</h2>
    <div class="small">Tap a day to filter history</div>
    <div id="cal"></div>
    <div style="display:flex;gap:8px;margin-top:8px"><span id="filterLabel" class="small" style="flex:1">Filtering: All</span><button class="btn" style="width:auto;padding:6px 10px;font-size:12px;background:#eee;color:#111" onclick="showAll()">Show all</button></div>
  </div>

  <div class="card">
    <h2>📊 Stats</h2>
    <div class="small"><span id="total">Total 0</span> • <span id="avg">Avg 0.0</span> • <span id="week">This week 0</span></div>
    <div class="statsbar" id="chart"></div>
  </div>

  <div class="card">
    <h2>📜 History</h2>
    <div id="history"></div>
  </div>

  <div class="card" style="text-align:center">
    <h2>📦 Android APK</h2>
    <p class="small">Native build verified — 6.5 MB, SDK 34, Material3</p>
    <a class="btn" href="/apk/app-debug.apk" download style="display:block;text-decoration:none;text-align:center">⬇ Download APK</a>
    <p class="small">If APK link 404, grab from: android/app/build/outputs/apk/debug/app-debug.apk</p>
  </div>
</div>
<script>
const MOODS=[{name:'Terrible',emoji:'😭',v:1,color:'#ef5350'},{name:'Bad',emoji:'😕',v:2,color:'#ff8a65'},{name:'Okay',emoji:'😐',v:3,color:'#ffd54f'},{name:'Good',emoji:'🙂',v:4,color:'#aed581'},{name:'Great',emoji:'😄',v:5,color:'#66bb6a'}];
let selected=null,selectedTs=Date.now(),filterDay=null;
const fmt=d=>new Date(d).toLocaleString(); const dayStr=d=>new Date(d).toISOString().slice(0,10);
function load(){try{return JSON.parse(localStorage.getItem('moods')||'[]')}catch{return[]}}
function saveStore(a){localStorage.setItem('moods',JSON.stringify(a))}
function renderMoods(){const c=document.getElementById('moods');c.innerHTML='';MOODS.forEach(m=>{const b=document.createElement('button');b.className='mood'+(selected===m.name?' selected':'');b.textContent=m.emoji+' '+m.name;b.onclick=()=>{selected=m.name;renderMoods()};c.appendChild(b)})}
function updateDateLabel(){document.getElementById('dateLabel').textContent='Date: '+fmt(selectedTs)}
function pickDate(){const i=prompt('Enter date YYYY-MM-DD',dayStr(selectedTs));if(!i)return;const d=new Date(i+'T00:00:00');if(isNaN(d))return alert('Invalid');const cur=new Date(selectedTs);d.setHours(cur.getHours(),cur.getMinutes());selectedTs=d.getTime();updateDateLabel()}
function pickTime(){const i=prompt('Enter time HH:MM (24h)',new Date(selectedTs).toTimeString().slice(0,5));if(!i)return;const [h,m]=i.split(':').map(Number);if(isNaN(h))return;const d=new Date(selectedTs);d.setHours(h,m);selectedTs=d.getTime();updateDateLabel()}
function save(){if(!selected)return alert('Select a mood');const note=document.getElementById('note').value.trim();const arr=load();arr.unshift({id:Date.now(),mood:selected,note,ts:selectedTs});saveStore(arr);document.getElementById('note').value='';selected=null;selectedTs=Date.now();updateDateLabel();renderMoods();renderAll()}
function showAll(){filterDay=null;renderAll()}
function renderCal(){const now=new Date();const y=now.getFullYear(),m=now.getMonth();const first=new Date(y,m,1).getDay();const days=new Date(y,m+1,0).getDate();const entries=load();const byDay=new Set(entries.map(e=>dayStr(e.ts)));let h='<table class="calendar"><tr><th>Su<th>Mo<th>Tu<th>We<th>Th<th>Fr<th>Sa<tr>';for(let i=0;i<first;i++)h+='<td>';for(let d=1;d<=days;d++){const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;const has=byDay.has(ds);h+=`<td class="${has?'has ':''}${filterDay===ds?'selected':''}" onclick="filterDay='${ds}';renderAll()">${d}`;if((first+d)%7===0)h+='<tr>'}h+='</table>';document.getElementById('cal').innerHTML=h;document.getElementById('filterLabel').textContent='Filtering: '+(filterDay||'All')}
function renderStats(){const arr=load();const total=arr.length;const avg=total? (arr.reduce((s,e)=>s+MOODS.find(x=>x.name===e.mood).v,0)/total).toFixed(1):'0.0';const week=arr.filter(e=>Date.now()-e.ts<7*864e5).length;document.getElementById('total').textContent='Total '+total;document.getElementById('avg').textContent='Avg '+avg+' /5';document.getElementById('week').textContent='This week '+week;const counts={};MOODS.forEach(m=>counts[m.name]=arr.filter(e=>e.mood===m.name).length);const max=Math.max(1,...Object.values(counts));const c=document.getElementById('chart');c.innerHTML='';MOODS.forEach(m=>{const h=(counts[m.name]/max*90);c.innerHTML+=`<div class="bar" style="height:${20+h}% ; background:${m.color}"><span style="position:absolute;top:-18px;font-weight:700">${counts[m.name]||''}</span><i>${m.emoji}</i><span>${m.name}</span></div>`})}
function renderHistory(){const arr=load();const filtered=filterDay?arr.filter(e=>dayStr(e.ts)===filterDay):arr;const h=document.getElementById('history');if(!filtered.length){h.innerHTML='<p class="small" style="text-align:center;padding:20px">No entries yet. Add your first mood!</p>';return}h.innerHTML=filtered.map(e=>{const m=MOODS.find(x=>x.name===e.mood);return `<div class="entry"><div class="emoji">${m.emoji}</div><div style="flex:1"><b>${m.name}</b> <span class="small">${fmt(e.ts)}</span><div class="small" style="color:#111;margin-top:4px">${e.note||'<i style=color:#999>no note</i>'}</div></div><button onclick="edit(${e.id})" style="border:0;background:#f3eaff;border-radius:8px;padding:6px 10px;cursor:pointer">Edit</button><button onclick="del(${e.id})" style="border:0;background:#fee;border-radius:8px;padding:6px 10px;cursor:pointer">🗑</button></div>`}).join('')}
function del(id){saveStore(load().filter(e=>e.id!==id));renderAll()}
function edit(id){const arr=load();const e=arr.find(x=>x.id===id);if(!e)return;const m=prompt('Mood: Terrible, Bad, Okay, Good, Great',e.mood);if(m&&MOODS.find(x=>x.name===m))e.mood=m;const n=prompt('Note',e.note);if(n!==null)e.note=n;const d=prompt('Date YYYY-MM-DD HH:MM',new Date(e.ts).toISOString().slice(0,16).replace('T',' '));if(d){const nd=new Date(d.replace(' ','T'));if(!isNaN(nd))e.ts=nd.getTime()}saveStore(arr);renderAll()}
function renderAll(){renderCal();renderStats();renderHistory()}
if(!load().length){saveStore([{id:1,mood:'Good',note:'First day! Feeling optimistic.',ts:Date.now()-864e5},{id:2,mood:'Great',note:'Shipped the APK 🚀',ts:Date.now()}])}
renderMoods();updateDateLabel();renderAll();
</script>
