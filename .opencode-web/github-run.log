[92m[1m| [0m[90m Write    [0m{"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Mood Tracker</title>\n<style>\n  :root {\n    --bg: #0f1117;\n    --surface: #181c27;\n    --surface-2: #212737;\n    --border: #2c3446;\n    --text: #e8ebf2;\n    --text-dim: #9aa3b5;\n    --accent: #7c5cff;\n    --accent-soft: rgba(124, 92, 255, 0.15);\n    --radius: 14px;\n\n    --mood-1: #f43f5e;\n    --mood-2: #fb923c;\n    --mood-3: #facc15;\n    --mood-4: #4ade80;\n    --mood-5: #38bdf8;\n  }\n\n  @media (prefers-color-scheme: light) {\n    :root {\n      --bg: #f4f5fa;\n      --surface: #ffffff;\n      --surface-2: #eef0f7;\n      --border: #dfe3ee;\n      --text: #1c2130;\n      --text-dim: #66708a;\n    }\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    min-height: 100vh;\n    display: flex;\n    justify-content: center;\n    padding: 24px 16px 64px;\n    line-height: 1.45;\n  }\n\n  .app { width: 100%; max-width: 720px; }\n\n  header { text-align: center; margin-bottom: 28px; }\n  header h1 {\n    font-size: 28px;\n    letter-spacing: -0.02em;\n    background: linear-gradient(90deg, var(--accent), var(--mood-5));\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n  header p { color: var(--text-dim); font-size: 14px; margin-top: 4px; }\n\n  .card {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    padding: 20px;\n    margin-bottom: 20px;\n  }\n\n  .card h2 { font-size: 15px; font-weight: 600; margin-bottom: 14px; color: var(--text); }\n\n  .date-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 16px;\n  }\n  .date-nav-btn {\n    background: var(--surface-2);\n    border: 1px solid var(--border);\n    color: var(--text-dim);\n    width: 34px; height: 34px;\n    border-radius: 10px;\n    cursor: pointer;\n    font-size: 15px;\n    transition: all .15s ease;\n  }\n  .date-nav-btn:hover { color: var(--text); border-color: var(--accent); }\n\n  #selected-date-label { font-weight: 600; font-size: 15px; }\n\n  .mood-picker { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }\n\n  .mood-btn {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n    padding: 12px 4px 10px;\n    background: var(--surface-2);\n    border: 2px solid transparent;\n    border-radius: 12px;\n    cursor: pointer;\n    transition: transform .12s ease, border-color .12s ease;\n  }\n  .mood-btn:hover { transform: translateY(-2px); }\n  .mood-btn .emoji { font-size: 26px; }\n  .mood-btn .label { font-size: 11px; color: var(--text-dim); font-weight: 500; }\n  .mood-btn.selected[data-mood=\"1\"] { border-color: var(--mood-1); background: rgba(244,63,94,.12); }\n  .mood-btn.selected[data-mood=\"2\"] { border-color: var(--mood-2); background: rgba(251,146,60,.12); }\n  .mood-btn.selected[data-mood=\"3\"] { border-color: var(--mood-3); background: rgba(250,204,21,.12); }\n  .mood-btn.selected[data-mood=\"4\"] { border-color: var(--mood-4); background: rgba(74,222,128,.12); }\n  .mood-btn.selected[data-mood=\"5\"] { border-color: var(--mood-5); background: rgba(56,189,248,.12); }\n  .mood-btn.selected .label { color: var(--text); }\n\n  textarea {\n    width: 100%;\n    margin-top: 16px;\n    background: var(--surface-2);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    color: var(--text);\n    padding: 12px;\n    font-family: inherit;\n    font-size: 14px;\n    resize: vertical;\n    min-height: 64px;\n  }\n  textarea:focus { outline: none; border-color: var(--accent); }\n  textarea::placeholder { color: var(--text-dim); }\n\n  .save-row { display: flex; align-items: center; gap: 12px; margin-top: 14px; }\n  .btn-primary {\n    background: var(--accent);\n    color: #fff;\n    border: none;\n    padding: 10px 22px;\n    border-radius: 10px;\n    font-size: 14px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: opacity .15s ease;\n  }\n  .btn-primary:hover { opacity: .88; }\n  .btn-primary:disabled { opacity: .45; cursor: not-allowed; }\n\n  .btn-ghost {\n    background: transparent;\n    border: 1px solid var(--border);\n    color: var(--text-dim);\n    padding: 9px 16px;\n    border-radius: 10px;\n    font-size: 13px;\n    cursor: pointer;\n  }\n  .btn-ghost:hover { color: var(--mood-1); border-color: var(--mood-1); }\n\n  #form-status { font-size: 13px; color: var(--mood-4); opacity: 0; transition: opacity .3s ease; }\n  #form-status.show { opacity: 1; }\n\n  /* Stats */\n  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }\n  .stat {\n    background: var(--surface-2);\n    border-radius: 12px;\n    padding: 14px 10px;\n    text-align: center;\n  }\n  .stat .value { font-size: 22px; font-weight: 700; }\n  .stat .name { font-size: 11px; color: var(--text-dim); margin-top: 2px; text-transform: uppercase; letter-spacing: .05em; }\n\n  /* Heatmap */\n  .heatmap-scroll { overflow-x: auto; padding-bottom: 4px; }\n  .heatmap {\n    display: grid;\n    grid-auto-flow: column;\n    grid-template-rows: repeat(7, 16px);\n    gap: 4px;\n  }\n  .heat-cell {\n    width: 16px; height: 16px;\n    border-radius: 4px;\n    background: var(--surface-2);\n    cursor: default;\n    position: relative;\n  }\n  .heat-cell.future { visibility: hidden; }\n  .heat-cell.today { outline: 2px solid var(--accent); outline-offset: 1px; }\n  .heat-cell[data-mood=\"1\"] { background: var(--mood-1); }\n  .heat-cell[data-mood=\"2\"] { background: var(--mood-2); }\n  .heat-cell[data-mood=\"3\"] { background: var(--mood-3); }\n  .heat-cell[data-mood=\"4\"] { background: var(--mood-4); }\n  .heat-cell[data-mood=\"5\"] { background: var(--mood-5); }\n\n  .heatmap-legend {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 10px;\n    font-size: 11px;\n    color: var(--text-dim);\n  }\n  .legend-dots { display: flex; gap: 4px; align-items: center; }\n  .legend-dot { width: 12px; height: 12px; border-radius: 3px; }\n\n  /* History */\n  .history-empty { color: var(--text-dim); font-size: 14px; text-align: center; padding: 18px 0; }\n  .entry {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    padding: 12px 4px;\n    border-bottom: 1px solid var(--border);\n  }\n  .entry:last-child { border-bottom: none; }\n  .entry .emoji { font-size: 26px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: var(--surface-2); border-radius: 10px; flex-shrink: 0; }\n  .entry .info { flex: 1; min-width: 0; }\n  .entry .when { font-size: 13px; font-weight: 600; }\n  .entry .note { font-size: 13px; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .entry .actions { display: flex; gap: 6px; }\n  .icon-btn {\n    background: none; border: none; cursor: pointer;\n    color: var(--text-dim); font-size: 15px; padding: 4px 6px; border-radius: 6px;\n  }\n  .icon-btn:hover { color: var(--text); background: var(--surface-2); }\n  .icon-btn.delete:hover { color: var(--mood-1); }\n\n  footer { text-align: center; font-size: 12px; color: var(--text-dim); margin-top: 8px; }\n\n  @media (max-width: 480px) {\n    .stats-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; }\n    .card { padding: 16px; }\n    .mood-picker { gap: 6px; }\n    .mood-btn .emoji { font-size: 22px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <h1>Mood Tracker</h1>\n    <p>Check in with yourself, one day at a time.</p>\n  </header>\n\n  <section class=\"card\" id=\"log-card\">\n    <h2>How are you feeling?</h2>\n    <div class=\"date-row\">\n      <button class=\"date-nav-btn\" id=\"prev-day\" aria-label=\"Previous day\">&#8249;</button>\n      <span id=\"selected-date-label\"></span>\n      <button class=\"date-nav-btn\" id=\"next-day\" aria-label=\"Next day\">&#8250;</button>\n    </div>\n    <div class=\"mood-picker\" id=\"mood-picker\"></div>\n    <textarea id=\"note-input\" placeholder=\"Add a note about your day (optional)...\" maxlength=\"500\"></textarea>\n    <div class=\"save-row\">\n      <button class=\"btn-primary\" id=\"save-btn\">Save entry</button>\n      <button class=\"btn-ghost\" id=\"clear-entry-btn\" hidden>Remove entry</button>\n      <span id=\"form-status\">Saved ✓</span>\n    </div>\n  </section>\n\n  <section class=\"card\">\n    <h2>Last 20 weeks</h2>\n    <div class=\"heatmap-scroll\"><div class=\"heatmap\" id=\"heatmap\"></div></div>\n    <div class=\"heatmap-legend\">\n      <span id=\"range-label\"></span>\n      <div class=\"legend-dots\">\n        <div class=\"legend-dot\" style=\"background:var(--mood-1)\"></div>\n        <div class=\"legend-dot\" style=\"background:var(--mood-2)\"></div>\n        <div class=\"legend-dot\" style=\"background:var(--mood-3)\"></div>\n        <div class=\"legend-dot\" style=\"background:var(--mood-4)\"></div>\n        <div class=\"legend-dot\" style=\"background:var(--mood-5)\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"card\">\n    <h2>Overview</h2>\n    <div class=\"stats-grid\">\n      <div class=\"stat\"><div class=\"value\" id=\"stat-total\">0</div><div class=\"name\">Entries</div></div>\n      <div class=\"stat\"><div class=\"value\" id=\"stat-streak\">0</div><div class=\"name\">Day streak</div></div>\n      <div class=\"stat\"><div class=\"value\" id=\"stat-top\">–</div><div class=\"name\">Top mood</div></div>\n    </div>\n  </section>\n\n  <section class=\"card\">\n    <h2>Recent entries</h2>\n    <div id=\"history\"></div>\n  </section>\n\n  <footer>All data stays in your browser.</footer>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  const MOODS = [\n    { value: 1, emoji: \"😞\", label: \"Struggling\" },\n    { value: 2, emoji: \"😕\", label: \"Low\" },\n    { value: 3, emoji: \"😐\", label: \"Okay\" },\n    { value: 4, emoji: \"🙂\", label: \"Good\" },\n    { value: 5, emoji: \"😄\", label: \"Great\" },\n  ];\n  const WEEKS = 20;\n  const STORAGE_KEY = \"mood-tracker.entries.v1\";\n\n  const $ = (id) => document.getElementById(id);\n\n  let entries = load();\n  let selectedDate = todayISO();\n\n  function todayISO() {\n    const d = new Date();\n    return toISO(d.getFullYear(), d.getMonth(), d.getDate());\n  }\n\n  function toISO(y, m, d) {\n    return y + \"-\" + String(m + 1).padStart(2, \"0\") + \"-\" + String(d).padStart(2, \"0\");\n  }\n\n  function parseISO(iso) {\n    const [y, m, d] = iso.split(\"-\").map(Number);\n    return new Date(y, m - 1, d);\n  }\n\n  function load() {\n    try {\n      const raw = localStorage.getItem(STORAGE_KEY);\n      if (!raw) return {};\n      const parsed = JSON.parse(raw);\n      const clean = {};\n      for (const key of Object.keys(parsed)) {\n        const e = parsed[key];\n        if (/^\\d{4}-\\d{2}-\\d{2}$/.test(key) && e && MOODS.some((m) => m.value === e.mood)) {\n          clean[key] = { mood: e.mood, note: typeof e.note === \"string\" ? e.note.slice(0, 500) : \"\" };\n        }\n      }\n      return clean;\n    } catch {\n      return {};\n    }\n  }\n\n  function save() {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));\n  }\n\n  // ---- Mood picker ----\n\n  const picker = $(\"mood-picker\");\n  MOODS.forEach((mood) => {\n    const btn = document.createElement(\"button\");\n    btn.type = \"button\";\n    btn.className = \"mood-btn\";\n    btn.dataset.mood = mood.value;\n    btn.innerHTML = '<span class=\"emoji\">' + mood.emoji + '</span><span class=\"label\">' + mood.label + \"</span>\";\n    btn.addEventListener(\"click\", () => setFormMood(mood.value));\n    picker.appendChild(btn);\n  });\n\n  let formMood = null;\n\n  function setFormMood(value) {\n    formMood = value;\n    picker.querySelectorAll(\".mood-btn\").forEach((b) => {\n      b.classList.toggle(\"selected\", Number(b.dataset.mood) === value);\n    });\n  }\n\n  // ---- Date navigation ----\n\n  $(\"prev-day\").addEventListener(\"click\", () => shiftSelected(-1));\n  $(\"next-day\").addEventListener(\"click\", () => shiftSelected(1));\n\n  function shiftSelected(days) {\n    const d = parseISO(selectedDate);\n    d.setDate(d.getDate() + days);\n    selectedDate = toISO(d.getFullYear(), d.getMonth(), d.getDate());\n    renderForm();\n  }\n\n  function formatDateLong(iso) {\n    const d = parseISO(iso);\n    const opts = { weekday: \"long\", year: \"numeric\", month: \"long\", day: \"numeric\" };\n    return d.toLocaleDateString(undefined, opts);\n  }\n\n  function formatDateShort(iso) {\n    const d = parseISO(iso);\n    const opts = { weekday: \"short\", month: \"short\", day: \"numeric\", year: \"numeric\" };\n    return d.toLocaleDateString(undefined, opts);\n  }\n\n  // ---- Form ----\n\n  $(\"save-btn\").addEventListener(\"click\", () => {\n    if (!formMood) {\n      flashStatus(\"Pick a mood first ✗\", false);\n      return;\n    }\n    const note = $(\"note-input\").value.trim();\n    entries[selectedDate] = { mood: formMood, note: note };\n    save();\n    flashStatus(\"Saved ✓\", true);\n    renderAll();\n  });\n\n  $(\"clear-entry-btn\").addEventListener(\"click\", () => {\n    delete entries[selectedDate];\n    save();\n    renderAll();\n  });\n\n  let statusTimer = null;\n  function flashStatus(text, positive) {\n    const el = $(\"form-status\");\n    el.textContent = text;\n    el.style.color = positive ? \"var(--mood-4)\" : \"var(--mood-1)\";\n    el.classList.add(\"show\");\n    clearTimeout(statusTimer);\n    statusTimer = setTimeout(() => el.classList.remove(\"show\"), 1800);\n  }\n\n  function renderForm() {\n    $(\"selected-date-label\").textContent = formatDateLong(selectedDate);\n    const existing = entries[selectedDate];\n    setFormMood(existing ? existing.mood : null);\n    $(\"note-input\").value = existing ? existing.note : \"\";\n    $(\"clear-entry-btn\").hidden = !existing;\n    $(\"save-btn\").textContent = existing ? \"Update entry\" : \"Save entry\";\n  }\n\n  // ---- Heatmap (last N weeks ending today, weeks start Monday) ----\n\n  function renderHeatmap() {\n    const heatmap = $(\"heatmap\");\n    heatmap.innerHTML = \"\";\n\n    const today = parseISO(todayISO());\n    const endOfWeek = new Date(today);\n    const daysToSunday = 6 - ((today.getDay() + 6) % 7); // offset within Mon-start week\n    endOfWeek.setDate(today.getDate() + daysToSunday);\n\n    const cells = [];\n    const cursor = new Date(endOfWeek);\n    cursor.setDate(cursor.getDate() - (WEEKS * 7 - 1));\n\n    while (cursor <= endOfWeek) {\n      const iso = toISO(cursor.getFullYear(), cursor.getMonth(), cursor.getDate());\n      const cell = document.createElement(\"div\");\n      cell.className = \"heat-cell\";\n      cell.dataset.date = iso;\n      if (iso > todayISO()) {\n        cell.classList.add(\"future\");\n      } else if (entries[iso]) {\n        cell.dataset.mood = entries[iso].mood;\n        cell.title = formatDateShort(iso) + \" — \" + moodLabel(entries[iso].mood);\n      } else {\n        cell.title = formatDateShort(iso);\n      }\n      if (iso === todayISO()) cell.classList.add(\"today\");\n      cells.push(cell);\n      cursor.setDate(cursor.getDate() + 1);\n    }\n\n    cells.forEach((c) => heatmap.appendChild(c));\n    $(\"range-label\").textContent =\n      formatDateShort(toISO(cursor.getFullYear(), cursor.getMonth(), cursor.getDate()));\n    const firstIso = cells[0].dataset.date;\n    $(\"range-label\").textContent = formatDateShort(firstIso) + \" – \" + formatDateShort(todayISO());\n  }\n\n  function moodLabel(value) {\n    const m = MOODS.find((x) => x.value === value);\n    return m ? m.label : \"\";\n  }\n\n  // ---- Stats ----\n\n  function renderStats() {\n    const dates = Object.keys(entries).sort();\n    $(\"stat-total\").textContent = dates.length;\n\n    // Streak: consecutive days logged ending today or yesterday.\n    let streak = 0;\n    const d = parseISO(todayISO());\n    if (!entries[toISO(d.getFullYear(), d.getMonth(), d.getDate())]) {\n      d.setDate(d.getDate() - 1);\n    }\n    while (entries[toISO(d.getFullYear(), d.getMonth(), d.getDate())]) {\n      streak++;\n      d.setDate(d.getDate() - 1);\n    }\n    $(\"stat-streak\").textContent = streak;\n\n    const counts = [0, 0, 0, 0, 0, 0];\n    dates.forEach((k) => counts[entries[k].mood]++);\n    let topValue = 0;\n    for (let i = 1; i <= 5; i++) {\n      if (counts[i] > counts[topValue]) topValue = i;\n    }\n    const top = MOODS.find((m) => m.value === topValue);\n    $(\"stat-top\").innerHTML = top && dates.length\n      ? '<span title=\"' + top.label + '\">' + top.emoji + \"</span>\"\n      : \"–\";\n  }\n\n  // ---- History ----\n\n  function renderHistory() {\n    const container = $(\"history\");\n    container.innerHTML = \"\";\n\n    const dates = Object.keys(entries).sort().reverse().slice(0, 30);\n    if (!dates.length) {\n      container.innerHTML = '<div class=\"history-empty\">No entries yet — log your first mood above!</div>';\n      return;\n    }\n\n    dates.forEach((iso) => {\n      const e = entries[iso];\n      const row = document.createElement(\"div\");\n      row.className = \"entry\";\n\n      const mood = MOODS.find((m) => m.value === e.mood);\n      row.innerHTML =\n        '<div class=\"emoji\">' + mood.emoji + \"</div>\" +\n        '<div class=\"info\"><div class=\"when\">' + formatDateShort(iso) + ' · ' + mood.label + \"</div>\" +\n        (e.note ? '<div class=\"note\" title=\"' + escapeAttr(e.note) + '\">' + escapeHTML(e.note) + \"</div>\" : \"\") +\n        \"</div>\";\n\n      const actions = document.createElement(\"div\");\n      actions.className = \"actions\";\n\n      const editBtn = document.createElement(\"button\");\n      editBtn.className = \"icon-btn\";\n      editBtn.title = \"Edit\";\n      editBtn.textContent = \"✏️\";\n      editBtn.addEventListener(\"click\", () => {\n        selectedDate = iso;\n        renderForm();\n        window.scrollTo({ top: 0, behavior: \"smooth\" });\n      });\n\n      const delBtn = document.createElement(\"button\");\n      delBtn.className = \"icon-btn delete\";\n      delBtn.title = \"Delete\";\n      delBtn.textContent = \"🗑️\";\n      delBtn.addEventListener(\"click\", () => {\n        delete entries[iso];\n        save();\n        renderAll();\n      });\n\n      actions.appendChild(editBtn);\n      actions.appendChild(delBtn);\n      row.appendChild(actions);\n      container.appendChild(row);\n    });\n  }\n\n  function escapeHTML(str) {\n    return str.replace(/[&<>\"']/g, (ch) => ({\n      \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\",\n    })[ch]);\n  }\n\n  function escapeAttr(str) {\n    return escapeHTML(str);\n  }\n\n  // ---- Init ----\n\n  function renderAll() {\n    renderForm();\n    renderHeatmap();\n    renderStats();\n    renderHistory();\n  }\n\n  renderAll();\n})();\n</script>\n</body>\n</html>\n","filePath":"/home/runner/work/aiplay/aiplay/mood-tracker/index.html"}
