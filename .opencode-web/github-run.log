[92m[1m| [0m[90m Write    [0m{"filePath":"/home/runner/work/aiplay/aiplay/todo-app/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Todo List</title>\n  <style>\n    :root {\n      --bg: #f4f5f7;\n      --card: #ffffff;\n      --text: #1f2933;\n      --muted: #6b7280;\n      --border: #e5e7eb;\n      --accent: #2563eb;\n      --accent-hover: #1d4ed8;\n      --danger: #dc2626;\n      --danger-hover: #b91c1c;\n      --done: #16a34a;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n      background: var(--bg);\n      color: var(--text);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      padding: 48px 16px;\n    }\n\n    .app {\n      width: 100%;\n      max-width: 520px;\n    }\n\n    h1 {\n      font-size: 1.75rem;\n      margin-bottom: 20px;\n      text-align: center;\n    }\n\n    form {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 16px;\n    }\n\n    input[type=\"text\"] {\n      flex: 1;\n      padding: 12px 14px;\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      font-size: 1rem;\n      outline: none;\n      background: var(--card);\n      transition: border-color 0.15s ease;\n    }\n\n    input[type=\"text\"]:focus {\n      border-color: var(--accent);\n    }\n\n    button {\n      cursor: pointer;\n      border: none;\n      border-radius: 10px;\n      font-size: 1rem;\n      padding: 12px 18px;\n      transition: background 0.15s ease;\n    }\n\n    button.add {\n      background: var(--accent);\n      color: #fff;\n      font-weight: 600;\n    }\n\n    button.add:hover {\n      background: var(--accent-hover);\n    }\n\n    ul {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n\n    li {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      background: var(--card);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      padding: 12px 14px;\n    }\n\n    li.done .label {\n      text-decoration: line-through;\n      color: var(--muted);\n    }\n\n    li input[type=\"checkbox\"] {\n      width: 20px;\n      height: 20px;\n      accent-color: var(--done);\n      cursor: pointer;\n      flex-shrink: 0;\n    }\n\n    .label {\n      flex: 1;\n      word-break: break-word;\n    }\n\n    button.delete {\n      background: transparent;\n      color: var(--danger);\n      padding: 6px 10px;\n      border-radius: 8px;\n      font-weight: 600;\n    }\n\n    button.delete:hover {\n      background: #fee2e2;\n      color: var(--danger-hover);\n    }\n\n    .empty {\n      text-align: center;\n      color: var(--muted);\n      padding: 32px 0;\n    }\n  </style>\n</head>\n<body>\n  <main class=\"app\">\n    <h1>Todo List</h1>\n    <form id=\"new-todo-form\">\n      <input\n        type=\"text\"\n        id=\"new-todo-input\"\n        placeholder=\"What needs to be done?\"\n        autocomplete=\"off\"\n        aria-label=\"New todo\"\n        required\n      />\n      <button type=\"submit\" class=\"add\">Add</button>\n    </form>\n    <ul id=\"todo-list\"></ul>\n    <p class=\"empty\" id=\"empty-message\">Nothing to do yet. Add your first task above.</p>\n  </main>\n\n  <script>\n    const STORAGE_KEY = \"todos\";\n    const form = document.getElementById(\"new-todo-form\");\n    const input = document.getElementById(\"new-todo-input\");\n    const list = document.getElementById(\"todo-list\");\n    const emptyMessage = document.getElementById(\"empty-message\");\n\n    let todos = load();\n\n    function load() {\n      try {\n        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];\n      } catch {\n        return [];\n      }\n    }\n\n    function save() {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));\n    }\n\n    function render() {\n      list.innerHTML = \"\";\n      emptyMessage.hidden = todos.length > 0;\n\n      todos.forEach((todo) => {\n        const li = document.createElement(\"li\");\n        li.className = todo.completed ? \"done\" : \"\";\n\n        const checkbox = document.createElement(\"input\");\n        checkbox.type = \"checkbox\";\n        checkbox.checked = todo.completed;\n        checkbox.addEventListener(\"change\", () => toggle(todo.id));\n\n        const label = document.createElement(\"span\");\n        label.className = \"label\";\n        label.textContent = todo.text;\n\n        const remove = document.createElement(\"button\");\n        remove.className = \"delete\";\n        remove.textContent = \"Delete\";\n        remove.addEventListener(\"click\", () => removeTodo(todo.id));\n\n        li.append(checkbox, label, remove);\n        list.appendChild(li);\n      });\n    }\n\n    function add(text) {\n      todos.unshift({ id: Date.now(), text, completed: false });\n      save();\n      render();\n    }\n\n    function toggle(id) {\n      const todo = todos.find((t) => t.id === id);\n      if (todo) todo.completed = !todo.completed;\n      save();\n      render();\n    }\n\n    function removeTodo(id) {\n      todos = todos.filter((t) => t.id !== id);\n      save();\n      render();\n    }\n\n    form.addEventListener(\"submit\", (e) => {\n      e.preventDefault();\n      const text = input.value.trim();\n      if (!text) return;\n      add(text);\n      input.value = \"\";\n      input.focus();\n    });\n\n    render();\n  </script>\n</body>\n</html>\n"}
