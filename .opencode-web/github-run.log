</span>\n          </button>\n        </div>\n\n        <label for=\"note\" class=\"visually-hidden\">Note (optional)</label>\n        <input\n          type=\"text\"\n          id=\"note\"\n          placeholder=\"Add an optional note...\"\n          maxlength=\"140\"\n          autocomplete=\"off\"\n        />\n\n        <button type=\"submit\" id=\"save-btn\" class=\"primary-btn\" disabled>Save Entry</button>\n      </form>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"history-heading\">\n      <h2 id=\"history-heading\">History</h2>\n      <ul id=\"history-list\" class=\"history-list\"></ul>\n      <p id=\"empty-state\" class=\"empty-state hidden\">No entries yet. Log your first mood above!</p>\n    </section>\n  </main>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>\n"}
