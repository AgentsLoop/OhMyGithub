{
  "name": "rts-platform",
  "private": true,
  "version": "0.1.0",
  "description": "LLM-first 3D RTS platform — minimal verifiable foundation",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @rts/dev-shell dev --host 0.0.0.0 --port 3000",
    "start": "pnpm --filter @rts/dev-shell dev --host 0.0.0.0 --port 3000",
    "preview": "pnpm --filter @rts/dev-shell preview --host 0.0.0.0 --port 3000",
    "build": "pnpm -r build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm test",
    "check:boundaries": "eslint . --max-warnings=0",
    "prepare": "husky install 2>/dev/null || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.3",
    "playwright": "^1.48.0",
    "@playwright/test": "^1.48.0",
    "@vitest/coverage-v8": "^2.1.3"
  }
}
