{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // Easter egg — game-themed omo config. Pattern copied from docs/examples/default.jsonc
  // In-game meaning: each agent = one Squad AI discipline in Warehouse Ops.
  // Loaded nowhere at runtime; lore artifact + valid JSONC for the real loader.

  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "anthropic/claude-opus-5",
        "ultrawork": { "model": "anthropic/claude-opus-5", "reasoning": "max" },
        "prompt_append": "Squad Lead — own the warehouse, delegate sectors, call the flank."
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "prompt_append": "Breacher — push hard when player reloads. No hesitation."
      },
      "prometheus": {
        "prompt_append": "Flanker — circle perpendicular to LOS, cut off retreat."
      },
      "oracle": { "model": "openai/gpt-5.6-sol", "reasoning": "high", "prompt_append": "Marksman — hold mid-range, peek from crate cover." },
      "librarian": { "model": "github-copilot/grok-code-fast-1", "prompt_append": "Spotter — keep LOS, share position to squad." },
      "explore": { "model": "github-copilot/grok-code-fast-1" },
      "multimodal-looker": { "model": "google/gemini-3.1-pro", "prompt_append": "Point — lead pushes into central warehouse." },
      "metis": {},
      "momus": { "prompt_append": "Suppressive — sustain fire to force movement." },
      "atlas": {},
      "sisyphus-junior": { "model": "opencode/gpt-5-nano", "prompt_append": "Rookie — spawns in pairs on wave 3+." }
    },

    "categories": {
      "quick": { "model": "opencode/gpt-5-nano" },
      "unspecified-low": { "model": "xai/grok-4.6", "reasoning": "xhigh" },
      "unspecified-high": { "model": "anthropic/claude-opus-5", "reasoning": "max" },
      "visual-engineering": { "model": "anthropic/claude-opus-5", "reasoning": "max" },
      "deep": { "model": "openai/gpt-5.6-sol", "reasoning": "medium" },
      "ultrabrain": { "model": "openai/gpt-5.6-sol", "reasoning": "xhigh" }
    },

    "background_task": {
      "providerConcurrency": {
        "anthropic": 3,
        "openai": 3,
        "google": 5,
        "opencode": 10
      }
    },

    "experimental": { "aggressive_truncation": true }
  },

  // game_tuning is custom — ignored by the real loader, read as lore by the game
  "game_tuning": {
    "warehouse": "dark-industrial",
    "kills_to_extract": 10,
    "mag_size": 30,
    "squad_disciplines": 11,
    "note": "Warehouse Ops — MWIII dark military aesthetic, 11-discipline Squad AI (OMO homage)."
  }
}
